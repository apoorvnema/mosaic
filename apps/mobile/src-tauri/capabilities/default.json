{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "What the WebView may ask the shell to do. Scoped to the app data directory until the folder picker grants a vault folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPDATA/**/.*"
        },
        {
          "path": "$APPDATA/**/.*/**"
        }
      ]
    }
  ]
}
